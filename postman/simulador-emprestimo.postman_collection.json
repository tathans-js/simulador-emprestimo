    },
    {
      "name": "PM-08 [RF-08/CT-29] Listar histórico",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200',()=>pm.response.to.have.status(200));",
              "const lista=pm.response.json();",
              "pm.test('é uma lista',()=>pm.expect(lista).to.be.an('array'));",
              "pm.test('contém a simulação criada',()=>pm.expect(lista.map(s=>s.id)).to.include(Number(pm.collectionVariables.get('simId'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
