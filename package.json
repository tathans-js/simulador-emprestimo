{
  "name": "simulador-emprestimo",
  "version": "2.1.0",
  "description": "Simulador de Empréstimo - sistema-alvo do Projeto P2 de Testes e Qualidade de Software",
  "private": true,
  "main": "src/servidor.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/servidor.js",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:api": "node --test \"tests/api/**/*.test.js\"",
    "test:postman": "node scripts/rodar_postman.js",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:nf": "node --test --test-concurrency=1 \"tests/nao-funcionais/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/unit/**/*.test.js\" \"tests/api/**/*.test.js\"",
    "lint": "eslint src public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "newman": "^6.2.3",
    "selenium-webdriver": "^4.53.0"
  }
}
